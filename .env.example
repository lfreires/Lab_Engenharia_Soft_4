# =============================================================================
# Livraria application config
# Copy this file to .env and fill values.
# Never commit the real .env file.
# =============================================================================

# Environment: local | staging | production
APP_ENV=local

# HTTP port
# Cloud Run provides $PORT (default 8080)
APP_PORT=8080

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------

# Used by legacy TXT repositories in Tk app
DATA_DIR=./data

# API persistence backend:
# - sql: SQLAlchemy + Postgres/SQLite
# - firestore: Cloud Firestore (Step 11 option B)
PERSISTENCE_BACKEND=sql

# SQL backend URL examples
DATABASE_URL=sqlite:///./data/livraria.db
# DATABASE_URL=postgresql+psycopg://livraria:livraria@localhost:5432/livraria
# DATABASE_URL=postgresql+psycopg://user:pass@/livraria?host=/cloudsql/PROJECT:REGION:INSTANCE

# Firestore backend settings
# FIRESTORE_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE=(default)

# -----------------------------------------------------------------------------
# Auth / JWT
# In production, read from Secret Manager.
# -----------------------------------------------------------------------------

JWT_SECRET=change-me-insecure-dev-only
JWT_EXPIRES_MINUTES=60

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

LOG_LEVEL=INFO
